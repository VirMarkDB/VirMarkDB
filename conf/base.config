// Ressources et gestion des erreurs, communes à toutes les exécutions
process {
    // Valeurs par défaut pour tous les process
    cpus   = 1
    memory = 1.GB
    time   = 1.h

    // Relance si mémoire ou temps dépassé (codes 137 à 140), arrêt sinon
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries    = 3

    // Mémoire dynamique : réévaluée à chaque tentative (task.attempt)
    withLabel: 'process_low' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }

}
