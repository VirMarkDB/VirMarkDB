params {
    general_input = "${projectDir}/input"
    outdir = "${projectDir}/output"
    outdir_generation = "${params.outdir}/database_generation"

    scripts = "${projectDir}/scripts"
    scripts_generation = "${params.scripts}/database_generation"
    hmm_evalue = 1e-5
    run_assessment = false
    run_statistics = true
    nr_database = null
    assessment_rules = "${params.general_input}/assessment_rules.tsv"
    private_genomes = null
    genome_batch_size = 20
    genome_download_parallelism = 3
    ictv_version = 'VMR_MSL41.v1.20260729'
}

// Publish outputs as copies
workflow.output.mode = 'copy'

// Shared resource labels and error handling 
includeConfig 'conf/base.config'

// Declare software environments centrally for all modules.
process {
    withName: 'GENERATE_MANIFEST' {
        conda     = 'conda-forge::r-base=4.5.2 conda-forge::r-tidyverse conda-forge::r-readxl'
    }
    withName: 'DOWNLOAD_GENOMES' {
        conda     = 'bioconda::entrez-direct'
    }
    withName: 'COLLECT_REF' {
        conda     = 'conda-forge::r-base=4.5.2 conda-forge::r-readr conda-forge::r-rentrez bioconda::bioconductor-biostrings'
    }
    withName: 'HMM_PROFILE' {
        conda     = 'mafft=7.525 hmmer=3.3.2'
    }
    withName: 'HMM_SEARCH' {
        conda     = 'hmmer=3.3.2'
    }
    withName: 'FINAL_RESULTS' {
        conda = 'conda-forge::r-base=4.5.2 conda-forge::r-tidyverse conda-forge::r-knitr bioconda::bioconductor-biostrings'
    }
    withName: 'COLLECT_POOL' {
        conda = 'bioconda::blast conda-forge::wget conda-forge::gawk'
    }
    withName: 'SELF_ALIGN|DATABASE_ALIGN' {
        conda = 'bioconda::mmseqs2=15.6f452'
    }
    withName: 'FILTER_POOL|ANALYSE_POOL|SUMMARY_STATISTICS' {
        conda = 'conda-forge::r-base=4.5.2 conda-forge::r-tidyverse bioconda::bioconductor-biostrings'
    }
    withName: 'CLUSTER_MISSING' {
        conda = 'bioconda::cd-hit=4.8.1'
    }
    withName: 'PRODIGAL' {
        conda     = 'bioconda::prodigal=2.6.3'
    }
}

// Keep the Conda cache outside published results.
conda.cacheDir = "${projectDir}/conda-cache"

// Set the Apptainer image cache for the execution host
//   export NXF_APPTAINER_CACHEDIR=<shared_directory>/sif

profiles {
    VirMarkDB {
        process.resourceLimits = [cpus: 6, memory: 10.GB, time: 1.h]
    }
    conda {
        conda.enabled       = true
        conda.useMicromamba = true
        conda.channels      = 'conda-forge,bioconda'
    }
    abims {
        includeConfig 'conf/abims.config'
    }
}

// Generate report 
report {
    enabled   = true
    file      = "${params.outdir}/reports/report.html"
    overwrite = true
}
// Generate workflow scheme
dag {
    enabled   = true
    file      = "${params.outdir}/reports/dag.html"
    overwrite = true
}
